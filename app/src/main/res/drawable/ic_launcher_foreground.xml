        android:pathData="M36,60 L47,70 L72,48"
        android:strokeWidth="4.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Акцентная точка (Apple touch) -->
    <path
        android:pathData="M70,68 A2.5,2.5 0 1 1 70,63 A2.5,2.5 0 1 1 70,68 Z"
        android:fillColor="#88FFFFFF" />
