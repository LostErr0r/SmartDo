        android:pathData="M34,36 H74 A16,16 0 0 1 90,52 V72 A16,16 0 0 1 74,88 H34 A16,16 0 0 1 18,72 V52 A16,16 0 0 1 34,36 Z"
        android:fillColor="#33000000" />

    <!-- Главная форма: Apple Squircle со стильным градиентом Blue-Indigo -->
